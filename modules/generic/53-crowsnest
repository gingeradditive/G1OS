#!/bin/bash
set -xe
export LC_ALL=C

########################################
# Functions and Basic Configuration    #
########################################

# Load common functions and set up cleanup trap
source /common.sh
install_cleanup_trap

# Load additional configuration (e.g., BASE_USER)
source /files/00-config

########################################
# Configuration                        #
########################################

REPO="https://github.com/mainsail-crew/crowsnest.git"
DEPS=(git make)
# Included by moonraker.conf (G1-Configs, G1-Printers): G1-Configs overwrites
# moonraker.conf, so the update_manager entry lives in its own file
MOONRAKER_CROWSNEST_CONF="/home/${BASE_USER}/printer_data/config/moonraker-crowsnest.conf"

########################################
# Install System Packages              #
########################################

apt-get install --yes "${DEPS[@]}"

########################################
# Clone Repository                     #
########################################

pushd "/home/${BASE_USER}" &> /dev/null || exit 1
sudo -u "${BASE_USER}" git clone ${REPO} crowsnest
popd &> /dev/null || exit 1

########################################
# Installation Crowsnest               #
########################################

pushd "/home/${BASE_USER}/crowsnest" &> /dev/null || exit 1
export CROWSNEST_UNATTENDED=1
export CROWSNEST_ADD_CROWSNEST_MOONRAKER=0
make install
popd &> /dev/null || exit 1

########################################
# Moonraker update_manager entry       #
########################################

# Crowsnest keeps one branch per major version (master = v4, v5, ...) and its
# moonraker_update.txt sets the matching primary_branch: copying it keeps
# Moonraker on the branch that was cloned (repo default at build time)
sudo -u "${BASE_USER}" cp "/home/${BASE_USER}/crowsnest/resources/moonraker_update.txt" \
    "${MOONRAKER_CROWSNEST_CONF}"

########################################
# Enable Service                       #
########################################

systemctl_if_exists enable crowsnest.service
